# Copy to .env and fill in. NEVER commit .env or share these values.

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=8611330364:AAE2WzOlbNQzZX-IQMb6JhL3GxwGAcZtaKg

# Google Gemini API Key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Default Model (ali-3.5-flash-lite)
